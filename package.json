{
  "name": "finhand",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @finhand/api",
    "db:logs": "docker compose logs --follow postgres",
    "db:migrate": "npm run db:migrate --workspace @finhand/api",
    "db:studio": "npm run db:studio --workspace @finhand/api",
    "db:up": "docker compose up --detach --wait postgres",
    "db:verify": "npm run db:verify --workspace @finhand/api",
    "dev:api": "npm run dev --workspace @finhand/api",
    "lint": "npm run lint --workspaces --if-present",
    "start:api": "npm run start --workspace @finhand/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
