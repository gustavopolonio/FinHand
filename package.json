{
  "name": "finhand",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "container:build:api": "docker build --platform linux/arm64 --file apps/api/Dockerfile --tag finhand-api:local .",
    "container:build:web": "docker build --platform linux/arm64 --build-arg NEXT_PUBLIC_API_URL=http://localhost:3001 --file apps/web/Dockerfile --tag finhand-web:local .",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @finhand/api",
    "db:logs": "docker compose logs --follow postgres",
    "db:migrate": "npm run db:migrate --workspace @finhand/api",
    "db:studio": "npm run db:studio --workspace @finhand/api",
    "db:test:down": "docker compose --profile test rm --stop --force postgres-test",
    "db:test:logs": "docker compose --profile test logs --follow postgres-test",
    "db:test:up": "docker compose --profile test up --detach --wait postgres-test",
    "db:up": "docker compose up --detach --wait postgres",
    "db:verify": "npm run db:verify --workspace @finhand/api",
    "dev:api": "npm run dev --workspace @finhand/api",
    "dev:tunnel": "npm run dev:tunnel --workspace @finhand/api",
    "dev:worker": "npm run dev:worker --workspace @finhand/api",
    "dev:web": "npm run dev --workspace @finhand/web",
    "infra:synth": "npm run synth --workspace @finhand/infra",
    "lint": "npm run lint --workspaces --if-present",
    "security:smoke:production": "npm run security:smoke:production --workspace @finhand/api --",
    "start:api": "npm run start --workspace @finhand/api",
    "start:worker": "npm run start:worker --workspace @finhand/api",
    "start:web": "npm run start --workspace @finhand/web",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @finhand/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
