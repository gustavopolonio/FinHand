# Local development only. Copy this file to .env before overriding defaults.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

POSTGRES_USER=finhand
POSTGRES_PASSWORD=finhand_local
POSTGRES_DB=finhand
POSTGRES_PORT=5433
DATABASE_URL=postgresql://finhand:finhand_local@localhost:5433/finhand

# Authentication. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
WEB_URL=http://localhost:3000

# Exposed to the browser. Use the public API origin in production.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Private document storage. AWS credentials are resolved by the SDK's default
# credential provider chain; do not commit access keys to this file.
AWS_REGION=sa-east-1
S3_UPLOAD_BUCKET=
